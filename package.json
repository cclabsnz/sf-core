{
  "name": "@cclabsnz/sf-core",
  "version": "0.3.0",
  "description": "Shared platform layer for CloudCounsel Salesforce sf plugins — API clients, org context, event log pull, report shell, and versioned IR schemas.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing/invariants.d.ts",
      "default": "./lib/testing/invariants.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "lint": "oxlint src test",
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/unit --passWithNoTests",
    "prepack": "npm run build",
    "clean": "rm -rf lib",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@salesforce/core": "^9",
    "@types/jest": "^29",
    "@types/node": "^22",
    "ajv": "^8",
    "jest": "^29",
    "oxlint": "^1.79.0",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/lib",
    "/schemas",
    "/src/assets",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!/lib/**/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cclabsnz/sf-core.git"
  },
  "homepage": "https://github.com/cclabsnz/sf-core#readme",
  "bugs": {
    "url": "https://github.com/cclabsnz/sf-core/issues"
  },
  "keywords": [
    "salesforce",
    "sf-plugin",
    "sfdx",
    "security",
    "audit",
    "tooling-api"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.6",
      "js-yaml@3": "^3.15.1",
      "handlebars": "^4.7.9",
      "brace-expansion": "^5.0.9",
      "fast-uri@3": "^3.1.5"
    }
  },
  "peerDependencies": {
    "@salesforce/core": "^8 || ^9"
  }
}
